# Salin ke .env — nilai di file ini TERSAMBUNG ke docker-compose:
# dipakai sebagai default substitusi (${VAR:-default} di docker-compose.yml).
# Ubah nilai di sini = berefek ke stack (recreate service terkait).
# Hapus/kosongkan baris = default aman dari compose berlaku.

# ── Shared infrastructure ──────────────────────────────────────────────
POSTGRES_USER=arxiv
POSTGRES_PASSWORD=arxiv_secret
POSTGRES_DB=arxiv_db

# ── Service URLs (dipakai mcp-gateway) ─────────────────────────────────
ARXIV_SERVICE_URL=http://arxiv-go-backend:8080
EVAL_SERVICE_URL=http://llm-eval-framework:8002
RAG_SERVICE_URL=http://rag-api:8000

# ── Model LLM (python-ml, orkestrator mcp-gateway, rag-api) ────────────
GROQ_MODEL=openai/gpt-oss-20b

# ── Gateway ────────────────────────────────────────────────────────────
GATEWAY_LISTEN_ADDRESS=:8090
GROQ_API_KEY=gsk_your_actual_key_here

# ── arXiv backend ──────────────────────────────────────────────────────
ML_SERVICE_URL=http://arxiv-python-ml:8001
QDRANT_URL=http://qdrant:6333
OLLAMA_HOST=http://ollama:11434
# python-ml: "groq" (cloud, cepat) | "ollama" (phi3 lokal — butuh RAM lega)
LLM_PROVIDER=groq

# ── rag-research ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Ports exposed to host ──────────────────────────────────────────────
# arxiv-go-backend   :8080
# arxiv-python-ml    :8001
# mcp-gateway        :8090
# llm-eval-framework :8002
# rag-research       :8000
# postgres           :5432
# qdrant             :6333 (6334 = gRPC)
# ollama             :11435 (11434 = daemon host)
# redis              :6379 (profil monitoring)
# prometheus         :9090 (profil monitoring)
# grafana            :3000 (profil monitoring)
