# Workspace-level environment variables for docker-compose
# Copy to .env and adjust as needed.

# ── Shared infrastructure ──────────────────────────────────────────────
POSTGRES_USER=arxiv
POSTGRES_PASSWORD=arxiv_secret
POSTGRES_DB=arxiv_db

# ── Service URLs (used by mcp-gateway) ─────────────────────────────────
ARXIV_SERVICE_URL=http://arxiv-go-backend:8080
EVAL_SERVICE_URL=http://llm-eval-framework:8002
RAG_SERVICE_URL=http://rag-api:8000
GROQ_MODEL=openai/gpt-oss-20b

# ── Gateway ────────────────────────────────────────────────────────────
GATEWAY_LISTEN_ADDRESS=:8090
GROQ_API_KEY=your-groq-api-key-here

# ── arXiv backend ──────────────────────────────────────────────────────
ML_SERVICE_URL=http://arxiv-python-ml:8001
QDRANT_URL=http://qdrant:6333
OLLAMA_HOST=http://ollama:11434
LLM_PROVIDER=ollama

# ── rag-research ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Ports exposed to host ──────────────────────────────────────────────
# arxiv-go-backend   :8080
# arxiv-python-ml    :8001
# mcp-gateway        :8090
# llm-eval-framework :8002
# rag-research       :8000
# postgres           :5432
# qdrant             :6333
# ollama             :11434
# redis              :6379
# prometheus         :9090
# grafana            :3000
