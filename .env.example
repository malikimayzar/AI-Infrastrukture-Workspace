# ═══════════════════════════════════════════════════════════════════════
# AI Infra Workspace — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
# Copy to .env and adjust. All values have sensible defaults for local dev.
# NEVER commit .env — it contains secrets.
# ═══════════════════════════════════════════════════════════════════════

# ── Shared Infrastructure ─────────────────────────────────────────────
POSTGRES_USER=arxiv
POSTGRES_PASSWORD=arxiv_secret
POSTGRES_DB=arxiv_db

# ── Service URLs (internal Docker network) ────────────────────────────
ARXIV_SERVICE_URL=http://arxiv-go-backend:8080
EVAL_SERVICE_URL=http://llm-eval-framework:8002
RAG_SERVICE_URL=http://rag-api:8000
ML_SERVICE_URL=http://arxiv-python-ml:8001
QDRANT_URL=http://qdrant:6333
OLLAMA_HOST=http://ollama:11434

# ── LLM Provider ──────────────────────────────────────────────────────
# "groq" (cloud, fast) | "ollama" (local, RAM-heavy)
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=gsk_your_actual_key_here

# ── RAG Research ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CALIBRATION_METHOD=isotonic
CALIBRATION_MODEL_PATH=models/calibration_isotonic.joblib
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0

# ── MCP Gateway Auth & Rate Limiting ──────────────────────────────────
# Empty = auth disabled (dev mode)
GATEWAY_API_KEYS=
GATEWAY_RATE_LIMIT_RPM=60
GATEWAY_RATE_LIMIT_BURST=10
GATEWAY_ADMIN_KEY=

# ── OpenTelemetry Tracing (Optional) ──────────────────────────────────
# Enable with: docker compose --profile tracing up -d jaeger
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=mcp-gateway

# ── Ports (host) ──────────────────────────────────────────────────────
# 8090 mcp-gateway | 8080 arxiv-go | 8001 arxiv-ml | 8002 eval
# 8000 rag-api | 11435 ollama | 5432 postgres | 6333 qdrant
# 6379 redis (monitoring) | 9090 prometheus | 3000 grafana | 16686 jaeger
# ── Per-Key Rate Limiting (Optional) ──────────────────────────────────
# Per-key tier assignments: "key1:pro,key2:enterprise"
# GATEWAY_KEY_TIERS=sk-pro-123:pro,sk-ent-456:enterprise
