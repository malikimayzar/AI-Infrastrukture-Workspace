# ═══════════════════════════════════════════════════════════════════════════════════════
# AI Infra Workspace — Environment Configuration (Mode A: Root Docker Compose)
# ═══════════════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Set GROQ_API_KEY with your actual key (REQUIRED for generation)
# 3. Adjust other values as needed for your environment
# 4. NEVER commit .env — it contains secrets and is gitignored
#
# USAGE:
# - This is the canonical env file for Docker Mode A (root workspace)
# - For standalone development (Mode B), use individual repo .env.example files
# - All services use this configuration via docker-compose.yml
#
# ═══════════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 1: SHARED INFRASTRUCTURE
# ─────────────────────────────────────────────────────────────────────────────────────
# PostgreSQL database configuration
POSTGRES_USER=arxiv
POSTGRES_PASSWORD=arxiv_secret
POSTGRES_DB=arxiv_db

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 2: SERVICE URLs (Internal Docker Network)
# ─────────────────────────────────────────────────────────────────────────────────────
# These URLs are resolved via Docker internal DNS (container names)
ARXIV_SERVICE_URL=http://arxiv-go-backend:8080
EVAL_SERVICE_URL=http://llm-eval-framework:8002
RAG_SERVICE_URL=http://rag-api:8000
ML_SERVICE_URL=http://arxiv-python-ml:8001
QDRANT_URL=http://qdrant:6333
OLLAMA_HOST=http://ollama:11434

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 3: LLM PROVIDER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
# Provider selection strategy:
# - "single": Use only the primary provider (fastest, but no fallback)
# - "fallback": Sequential fallback (recommended for production)
# - "load_balanced": Distribute load across providers (advanced)
LLM_PROVIDER_STRATEGY=fallback

# Primary provider (used first)
LLM_PRIMARY_PROVIDER=groq

# Fallback providers (tried in order if primary fails)
# Comma-separated list: "anthropic,openai,ollama"
LLM_FALLBACK_PROVIDERS=anthropic,ollama

# ─────────────────────────────────────────────────────────────────────────────────────
# GROQ CONFIGURATION (Primary - Fast, Cost-Effective)
# ─────────────────────────────────────────────────────────────────────────────────────
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=gsk_your_actual_key_here
GROQ_MAX_RETRIES=2
GROQ_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────────────────────────────
# ANTHROPIC CONFIGURATION (Secondary - High Quality)
# ─────────────────────────────────────────────────────────────────────────────────────
# For fallback when Groq rate limits or fails
ANTHROPIC_MODEL=claude-3-haiku-20240307
ANTHROPIC_API_KEY=sk-ant-your_actual_key_here
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_TIMEOUT_MS=60000

# ─────────────────────────────────────────────────────────────────────────────────────
# OPENAI CONFIGURATION (Tertiary - Reliable)
# ─────────────────────────────────────────────────────────────────────────────────────
# For fallback when both Groq and Anthropic fail
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your_actual_key_here
OPENAI_MAX_RETRIES=2
OPENAI_TIMEOUT_MS=60000

# ─────────────────────────────────────────────────────────────────────────────────────
# OLLAMA CONFIGURATION (Local Fallback - No API Key Needed)
# ─────────────────────────────────────────────────────────────────────────────────────
# Final fallback when all cloud providers fail
# Requires Ollama running locally (higher latency, no cost)
OLLAMA_MODEL=phi3:mini
OLLAMA_KEEP_ALIVE=0
OLLAMA_TIMEOUT_MS=120000

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 4: RAG RESEARCH CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
# API server configuration
API_HOST=0.0.0.0
API_PORT=8000

# Confidence calibration
CALIBRATION_METHOD=isotonic
CALIBRATION_MODEL_PATH=models/calibration_isotonic.joblib

# Redis cache (opt-in - requires monitoring profile)
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 5: MCP GATEWAY CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
# Gateway server
GATEWAY_LISTEN_ADDRESS=:8090

# Authentication (empty = disabled for dev mode)
GATEWAY_API_KEYS=
GATEWAY_ADMIN_KEY=
GATEWAY_AUTH_HEADER_NAME=Authorization
GATEWAY_AUTH_HEADER_PREFIX=Bearer

# Rate limiting (token bucket per client IP)
GATEWAY_RATE_LIMIT_RPM=60
GATEWAY_RATE_LIMIT_BURST=10

# Per-key tier assignments (optional)
# Format: "key1:pro,key2:enterprise"
# Tiers: free (default), pro, enterprise
GATEWAY_KEY_TIERS=

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 6: DATABASE CONNECTION POOL (MCP Gateway)
# ─────────────────────────────────────────────────────────────────────────────────────
POSTGRES_POOL_MAX_OPEN=25
POSTGRES_POOL_MAX_IDLE=5
POSTGRES_POOL_MAX_LIFETIME=5m
POSTGRES_POOL_MAX_IDLE_TIME=1m

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 7: BACKEND TIMEOUTS (MCP Gateway)
# ─────────────────────────────────────────────────────────────────────────────────────
GATEWAY_REQUEST_TIMEOUT=620s
STORE_LOG_TIMEOUT=5s
ARXIV_TIMEOUT=600s
EVAL_TIMEOUT=120s
RAG_TIMEOUT=60s

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 8: RESPONSE SIZE LIMITS (MCP Gateway, in bytes)
# ─────────────────────────────────────────────────────────────────────────────────────
ARXIV_MAX_RESPONSE_BYTES=4194304
EVAL_MAX_RESPONSE_BYTES=1048576
RAG_MAX_RESPONSE_BYTES=4194304

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 9: OPENTELEMETRY TRACING (Optional)
# ─────────────────────────────────────────────────────────────────────────────────────
# Enable with: docker compose --profile tracing up -d jaeger
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=mcp-gateway

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 10: HOST PORT MAPPING (Reference)
# ─────────────────────────────────────────────────────────────────────────────────────
# These ports are defined in docker-compose.yml and mapped to host
# 8090 = mcp-gateway
# 8080 = arxiv-go-backend
# 8001 = arxiv-python-ml
# 8002 = llm-eval-framework
# 8000 = rag-api
# 11435 = ollama (container 11434)
# 5432 = postgres
# 6333 = qdrant
# 6379 = redis (monitoring profile)
# 9090 = prometheus (monitoring profile)
# 3000 = grafana (monitoring profile)
# 16686 = jaeger (tracing profile)
# ═══════════════════════════════════════════════════════════════════════════════════════
